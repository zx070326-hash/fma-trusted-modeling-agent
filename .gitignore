# Runtime and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local credentials and private signing material
.env
.env.*
!.env.example
!.env.sample
*.key
*.p12
*.pfx
*.keystore
*_private.pem
*private_key*.pem

# Local scratch and generated run output
/.tmp-*
/tmp/
/.fma-op-v70/
/bench_smoke/
/demo_output/
/codex_agent_output/
/codex_agent_output_final/
/codex_agent_output_v2/
/codex_agent_release/
/fma_bench_live_smoke/
/fma_bench_live_v0/
/fma_bench_release/
/fma_bench_release_complete/
/fma_bench_v0_accepted/
/fma_bench_v0_final/
/fma_bench_v0_release_799aff/

# Historical campaign artifacts remain local. Iteration 32 is the only
# transport protocol included in the cross-host snapshot.
/experiments/*
!/experiments/iteration_32/
!/experiments/iteration_32/**
!/experiments/iteration_33/
!/experiments/iteration_33/**

# Keep runtime caches ignored inside explicitly included campaign trees.
/experiments/iteration_33/**/__pycache__/
/experiments/iteration_33/**/*.py[cod]
